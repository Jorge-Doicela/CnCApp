# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api
BASE_URL=http://localhost:3000

# Database
# Use a PostgreSQL connection string (Neon requires ?sslmode=require)
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# Security
# Generate secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your_jwt_secret_here"
JWT_REFRESH_SECRET="your_refresh_token_secret_here"
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=14d
BCRYPT_ROUNDS=10

# CORS
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:8100,http://localhost:4200,https://your-app.vercel.app"
FRONTEND_URL="https://your-app.vercel.app"

# Storage
UPLOAD_DIR="uploads"

# Google ReCaptcha
RECAPTCHA_SECRET_KEY="your_recaptcha_secret_key"

# Email Configuration (SMTP)
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
